# Public. Safe in the Vite bundle. From the Appwrite project settings.
# Cloud example: https://<REGION>.cloud.appwrite.io/v1
# Also add a Web platform whose hostname is localhost.
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=

# Private. Never prefix these with VITE_.
# Setup script only. Scopes: databases.read, databases.write, tables.read, tables.write,
# columns.read, columns.write, indexes.read, indexes.write, functions.read, functions.write.
APPWRITE_API_KEY=

# Free key from https://console.groq.com/keys — no card on the free plan.
# The setup script copies this onto the Appwrite function. Do not put it in client code.
GROQ_API_KEY=
